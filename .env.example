# ============================================================
# Pulse-ZeroBaran — .env.example (FREE TIER — 100%)
# انسخ هذا الملف إلى .env وضع قيمك. كل شيء اختياري:
# بدون مفاتيح يعمل النظام في الوضع المحلي Offline بالكامل.
# ============================================================

# ---- العلامة التجارية ----
PULSE_BRAND=ZeroBaran Store
PULSE_ALERT_THRESHOLD=-0.2

# ---- الذكاء الاصطناعي (مجاني · اختياري) ----
# Google AI Studio: https://aistudio.google.com/apikey  (مجاني)
GEMINI_API_KEY=
# Groq Console: https://console.groq.com/keys  (مجاني)
GROQ_API_KEY=

# ---- تليجرام (مجاني · اختياري) ----
# أنشئ بوتاً عبر @BotFather ثم انسخ التوكن، وchat_id عبر @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Supabase (Free Tier · اختياري) ----
# شغّل db/schema.sql في SQL Editor أولاً
SUPABASE_URL=
SUPABASE_KEY=

# ---- مصادر الرصد (اختياري) ----
# RSS/Atom مفصولة بفواصل
PULSE_RSS_FEEDS=
# صفحات تقييمات HTML كمصفوفة JSON:
# [{"url":"https://store.example/reviews","item":".review","text":".text","rating":".rating","product":"ZB-Kit"}]
PULSE_WEB_PAGES=
# ملف تقييمات محلي CSV/JSON
PULSE_FILE_REVIEWS=

